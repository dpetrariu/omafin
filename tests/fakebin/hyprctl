#!/usr/bin/env python3
"""A stand-in hyprctl for the tests, so nothing reaches the real compositor:
`-j clients` lists one window for each running stand-in mpv started with
Omafin's PiP app id, `-j monitors` one scaled 6K monitor under a top bar, and
`dispatch` is written to $FAKE_HYPR_LOG."""
import json, os, sys

args = sys.argv[1:]
if args[:1] == ["-j"]:
    args = args[1:]
if args[:1] == ["clients"]:
    clients = []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            argv = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        except OSError:
            continue
        if any(a.endswith(b"fakebin/mpv") for a in argv) and b"--wayland-app-id=omafin-pip" in argv:
            clients.append({"address": "0x5a5a", "pid": int(pid), "monitor": 0, "floating": False, "pinned": False})
    print(json.dumps(clients))
elif args[:1] == ["monitors"]:
    print(json.dumps([{"id": 0, "x": 0, "y": 0, "width": 6016, "height": 3384, "scale": 2.0, "transform": 0, "reserved": [0, 26, 0, 0]}]))
elif args[:1] == ["dispatch"]:
    with open(os.environ.get("FAKE_HYPR_LOG", os.devnull), "a") as log:
        log.write(json.dumps(args[1:]) + "\n")
    print("ok")
